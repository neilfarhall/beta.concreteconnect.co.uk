{% set is_restricted = node.field_restricted_content.value == '1' %}
{% set channel = node.field_channel.entity.label|default('') %}

<div class="article-wrapper{% if is_restricted and not logged_in %} restricted-anonymous{% endif %}">

  {% if channel == 'Seminar Spotlight' %}
    {{ content|without('field_image') }}
  {% else %}
    {{ content }}
  {% endif %}

</div>
